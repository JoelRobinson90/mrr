<p id="notice"><%= notice %></p>

<h1>Admins</h1>

<table>
  <thead>
    <tr>
      <th>First name</th>
      <th>Last name</th>
      <th>Email</th>
      <th>Type</th>
      <th>Organization</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @admins.each do |admin| %>
      <tr>
        <td><%= admin.first_name %></td>
        <td><%= admin.last_name %></td>
        <td><%= admin.email %></td>
        <td><%= admin.type.humanize %></td>
        <td><%= admin.organization_name %></td>
        <td><%= link_to 'Show', admin_url(admin, type: admin.type) %></td>
        <td><%= link_to 'Edit', edit_admin_path(admin, type: admin.type) %></td>
        <td><%= button_to 'Destroy', admin_url(admin, type: admin.type), method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<p><%= link_to 'New Field Admin', new_admin_path(type: 'field_admin') %></p>
<p><%= link_to 'New Dispatcher', new_admin_path(type: 'field_dispatcher') %></p>
<p><%= link_to 'New Medarrive Admin', new_admin_path(type: 'medarrive_admin') %></p>