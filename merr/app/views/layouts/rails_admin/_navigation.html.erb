<div class="container-fluid">
  <div class="navbar-header">
    <a class="navbar-brand" href="<%= dashboard_path %>">
      <%= _get_plugin_name[0] || 'Rails' %>
      <small>
        <%= _get_plugin_name[1] || 'Admin' %>
      </small>
      <small class="label label-<%= _get_plugin_name[2].include?('prod') ? 'danger' : 'success' %>">
        <%= _get_plugin_name[2] || '' %>
      </small>
    </a>
    <button class="navbar-toggle" type="button" data-toggle="collapse" data-target="#secondary-navigation">
      <span class="sr-only">
        <%= t('admin.toggle_navigation') %>
      </span>
      <span class="icon-bar"></span>
      <span class="icon-bar"></span>
      <span class="icon-bar"></span>
    </button>
  </div>
  <div class="navbar-collapse collapse" id="secondary-navigation">
    <%= render partial: 'layouts/rails_admin/secondary_navigation' %>
  </div>
</div>
