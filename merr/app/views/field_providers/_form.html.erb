<%= form_with(model: field_provider, local: true) do |form| %>
  <% if field_provider.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(field_provider.errors.count, "error") %> prohibited this field_provider from being saved:</h2>

      <ul>
        <% field_provider.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :field_org_id %>
    <%= select("field_provider", "field_org_id", FieldOrg.all.collect {|p| [ p.name, p.id ] }, { include_blank: true }) %>
  </div>

  <div class="field">
    <%= form.label :first_name %>
    <%= form.text_field :first_name %>
  </div>

  <div class="field">
    <%= form.label :last_name %>
    <%= form.text_field :last_name %>
  </div>

  <div class="field">
    <%= form.label :phone %>
    <%= form.text_field :phone %>
  </div>

  <%= form.fields_for :user do |user_form| %>
    <div class="field">
      <%= user_form.label :email %>
      <%= user_form.text_field :email %>
    </div>

    <% unless field_provider.persisted? %>
      <div class="field">
        <%= user_form.label :password %>
        <%= user_form.text_field :password %>
      </div>

      <div class="field">
        <%= user_form.label :password_confirmation %>
        <%= user_form.text_field :password_confirmation %>
      </div>
    <% end %>
  <% end %>

  <div class="field">
    <%= form.label :date_of_birth %>
    <%= form.date_field :date_of_birth %>
  </div>

  <%= form.fields_for :address do |address_form| %>
    <div class="field">
      <%= address_form.label :address_line_one %>
      <%= address_form.text_field :address_line_one %>
    </div>

    <div class="field">
      <%= address_form.label :address_line_two %>
      <%= address_form.text_field :address_line_two %>
    </div>

    <div class="field">
      <%= address_form.label :city %>
      <%= address_form.text_field :city %>
    </div>

    <div class="field">
      <%= address_form.label :state %>
      <%= address_form.text_field :state %>
    </div>

    <div class="field">
      <%= address_form.label :zipcode %>
      <%= address_form.text_field :zipcode %>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :avatar %>
    <%= image_tag field_provider.avatar.variant(resize_to_limit: [100, nil]) if field_provider.avatar.attached? %>
    <%= form.file_field :avatar %>
  </div>

  <div class="field">
    <%= form.label :bio %>
    <%= form.text_field :bio %>
  </div>

  <div class="field">
    <%= form.label :provider_level %>
    <%= select(:field_provider, :provider_level, options_for_select(['EMT', 'EMT'])) %>
  </div>

  <div class="actions">
    <%= form.submit %>
  </div>
<% end %>
