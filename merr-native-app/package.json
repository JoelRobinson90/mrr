{
  "name": "medarrive-native-app",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint '**/*.{js, jsx}'",
    "lint-fix": "eslint '**/*.{js, jsx}' --fix",
    "debugger": "rndebugger-open --open --port 19000",
    "prod-mode": "npx expo start --no-dev --minify",
    "expo-apple-prod-build": "eas build -p ios --profile production",
    "expo-android-prod-build": "eas build -p android --profile production",
    "local-apple-prod-build": "eas build -p ios --profile production --local",
    "apple-submit": "eas submit -p ios --latest",
    "android-submit": "eas submit -p android --latest",
    "test": "jest --silent --coverage --detectOpenHandles"
  },
  "dependencies": {
    "@apollo/client": "^3.7.1",
    "@expo-google-fonts/inter": "^0.2.2",
    "@expo/vector-icons": "^13.0.0",
    "@react-native-async-storage/async-storage": "1.17.11",
    "@react-native-community/masked-view": "^0.1.11",
    "@react-navigation/bottom-tabs": "^6.4.0",
    "@react-navigation/native": "^6.0.13",
    "@react-navigation/native-stack": "^6.9.1",
    "@sentry/cli": "^2.16.1",
    "@sentry/react-native": "4.13.0",
    "@testing-library/react-native": "^12.0.1",
    "apollo-link": "^1.2.14",
    "axios": "^1.1.3",
    "date-fns": "^2.29.3",
    "dotenv": "^16.0.3",
    "expo": "~48.0.10",
    "expo-application": "~5.1.1",
    "expo-asset": "~8.9.1",
    "expo-auth-session": "~4.0.3",
    "expo-constants": "~14.2.1",
    "expo-crypto": "~12.2.1",
    "expo-device": "~5.2.1",
    "expo-font": "~11.1.1",
    "expo-linking": "~4.0.1",
    "expo-localization": "~14.1.1",
    "expo-location": "~15.1.1",
    "expo-random": "~13.1.1",
    "expo-secure-store": "~12.1.1",
    "expo-splash-screen": "~0.18.2",
    "expo-status-bar": "~1.4.2",
    "expo-task-manager": "~11.1.1",
    "expo-updates": "~0.16.3",
    "expo-web-browser": "~12.1.1",
    "graphql": "^16.6.0",
    "lodash": "^4.17.21",
    "lottie-react-native": "5.1.4",
    "moment-timezone": "^0.5.41",
    "native-base": "^3.4.19",
    "prop-types": "^15.8.1",
    "proptypes": "^1.1.0",
    "react": "18.2.0",
    "react-native": "0.71.7",
    "react-native-gesture-handler": "~2.9.0",
    "react-native-maps": "1.3.2",
    "react-native-pager-view": "6.1.2",
    "react-native-reanimated": "~2.14.4",
    "react-native-safe-area-context": "4.5.0",
    "react-native-screens": "~3.20.0",
    "react-native-svg": "13.4.0",
    "react-native-tab-view": "^3.3.4",
    "react-navigation": "^4.4.4",
    "sentry-expo": "~6.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.19.3",
    "@testing-library/react-hooks": "^8.0.1",
    "eslint": "^7.32.0 || ^8.2.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-jest": "^27.2.1",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-react": "^7.28.0",
    "eslint-plugin-react-hooks": "^4.3.0",
    "jest": "^29.5.0",
    "jest-expo": "^48.0.2",
    "react-native-debugger-open": "^0.3.25",
    "react-native-svg-mock": "^2.0.0",
    "react-native-svg-transformer": "^1.0.0",
    "react-test-renderer": "^18.2.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "moduleFileExtensions": [
      "js",
      "jsx"
    ],
    "moduleNameMapper": {
      "\\.(svg)$": "<rootDir>/__mocks__/svgMock.js"
    },
    "transform": {
      "^.+\\.jsx?$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ]
  },
  "private": true
}
